# Production requires HTTPS, a persistent server, PostgreSQL and private S3 storage.
APP_ORIGIN=http://127.0.0.1:9200
PORT=9200
DATABASE_URL=
DATA_DIR=.data
# 32 random bytes in base64, stable across restarts. Never commit or share.
STORAGE_MASTER_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PLATFORM_WALLET=
# Both must be explicitly enabled after production checks.
ENABLE_LISTINGS=false
ENABLE_PAYMENTS=false
# Standard server-side inference. NOT confidential computing.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Answer-only paid queries (conventional AI; not confidential computing)
ENABLE_QUERY_PAYMENTS=false
# Optional 15% USDC reserve; does not itself swap or burn tokens
BUYBACK_WALLET=
ENABLE_CONVENTIONAL_QUERY_PROCESSING=false

# Optional third model for attested Private Model Router trials
PRIVATE_ROUTER_THIRD_MODEL=

# Nito attestation evidence prototype
NITO_API_KEY=
NITO_MODEL=
